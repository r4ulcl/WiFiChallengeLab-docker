/*
   WiFiChallenge by r4ulcl
*/

session_set_cookie_params(['httponly' => true, 'samesite' => 'Lax']);
session_start();                 /* Resume the session so it can be cleared */
$_SESSION = [];                  /* Remove every session variable */

/* Expire the session cookie so the browser stops resending a stale id */
if (ini_get('session.use_cookies')) {
    $p = session_get_cookie_params();
    setcookie(session_name(), '', time() - 42000,
        $p['path'], $p['domain'], $p['secure'], $p['httponly']);
}

session_destroy();               /* Destroy the server-side session */
header('Location: login.php');   /* Back to the login page */
exit;
