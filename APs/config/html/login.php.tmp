# AUTO-LOGIN FOR GLOBAL ADMIN
if (strpos($_SERVER['REMOTE_ADDR'], '${IP_MGT_TLS}.') === 0) {
  $_SESSION['UserData']['Username'] = '${IDENTITY_MGT_TLS}';
  $_SESSION['Username'] = '${IDENTITY_MGT_TLS}';
  header("location:index.php");
  exit;
}

# ALL FLAGS (replaced by envsubst)
$FLAG_MGT_RELAY_tls        = decode('${FLAG_MGT_RELAY_1}', $a);
$FLAG_MGT_RELAY_tablets    = decode('${FLAG_MGT_RELAY_TABLETS}', $a);
$flag_wps                 = decode('${FLAG_WPS}', $a);
$flag_wep                 = decode('${FLAG_WEP}', $a);
$flag_bruteforce          = decode('${FLAG_BRUTEFORCE}', $a);
$flag_downgrade           = decode('${FLAG_DOWNGRADE}', $a);
$flag_6ghz                = decode('${FLAG_6GHZ}', $a);
$flag_roam                = decode('${FLAG_ROAM}', $a);

function loginflag($flag) {
  echo "<div class=\"readout\"><div class=\"readout-top\"><span class=\"bars\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span>Signal locked · key recovered</div><button class=\"flag\" onclick=\"copyFlagToClipboard('{$flag}')\">{$flag}</button></div>";
}

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_MGT_RELAY}.') === 0)
  loginflag($FLAG_MGT_RELAY_tls);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_MGT_RELAY_TABLETS}.') === 0)
  loginflag($FLAG_MGT_RELAY_tablets);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_WPS}.') === 0)
  loginflag($flag_wps);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_WEP}.') === 0)
  loginflag($flag_wep);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_BRUTEFORCE}.') === 0)
  loginflag($flag_bruteforce);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_DOWNGRADE}.') === 0)
  loginflag($flag_downgrade);

if (strpos($_SERVER['REMOTE_ADDR'], '${IP_6GHZ}.') === 0)
  loginflag($flag_6ghz);

# Campus PMKID AP: flag from the wifi-campus AP subnet.
if (strpos($_SERVER['REMOTE_ADDR'], '${IP_ROAM1}.') === 0)
  loginflag($flag_roam);

