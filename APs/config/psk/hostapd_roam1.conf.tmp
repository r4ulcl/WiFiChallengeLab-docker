# wifi-campus - roaming ESS, AP 1 of 3 (WPA2-PSK, client-less PMKID target)
# Three APs share one ESSID on channels 1/6/11 and one PSK. There is NO client
# on this network on purpose: hostapd puts the PMKID in EAPOL message 1, so it
# is harvested straight from any BSSID (client-less, e.g. hcxdumptool), cracked
# offline, and because the PSK is shared one cracked PMKID unlocks the whole ESS.
#
# Kept as plain WPA2-PSK (no 802.11r / FT-PSK): mixing FT-PSK into the AKM list
# makes the client-less PMKID capture unreliable, and under mac80211_hwsim the
# capture also relies on the campus-scoped ACK patch in
# mac80211_hwsim/patch80211.sh (otherwise the AP's Assoc Resp / EAPOL msg 1 to
# hcxdumptool's random client MAC is never ACKed and hostapd drops the STA
# before the PMKID is sent). A real 802.11r FT roaming scenario should live on
# its own separate BSSID rather than on this PMKID target.
interface=$WLAN_ROAM1
driver=nl80211

hw_mode=g
channel=$CHANNEL_ROAM1
ssid=$ESSID_ROAM

wpa=2
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
wpa_passphrase=$PASS_ROAM_CLEAR

ctrl_interface=/run/hostapd-$WLAN_ROAM1
ctrl_interface_group=0
