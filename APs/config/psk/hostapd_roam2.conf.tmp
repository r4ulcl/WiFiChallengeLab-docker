# Roaming ESS - AP 2 of 3 (WPA2-PSK, client-less PMKID target).
# ESSID / channel / BSSID / PSK are templated from wlan_config(_challenge)
# (ESSID_ROAM, CHANNEL_ROAM2, MAC_ROAM2, PASS_ROAM) - keep this file agnostic.
# Plain WPA2-PSK on purpose (no 802.11r/FT-PSK). Needs the mac80211_hwsim ACK
# patch and the hostapd PMKID patch; see APs/PMKID_TESTING.md.
interface=$WLAN_ROAM2
driver=nl80211

hw_mode=g
channel=$CHANNEL_ROAM2
ssid=$ESSID_ROAM

wpa=2
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
wpa_passphrase=$PASS_ROAM_CLEAR

ctrl_interface=/run/hostapd-$WLAN_ROAM2
ctrl_interface_group=0
