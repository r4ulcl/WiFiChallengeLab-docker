# wifi-campus — roaming ESS, AP 3 of 3 (WPA2-PSK + 802.11r FT-PSK)
# Client-less PMKID target: hostapd puts the PMKID in EAPOL message 1, so the
# shared PSK can be captured and cracked without any associated client. All
# three campus APs share this PSK, so one cracked PMKID unlocks the whole ESS.
interface=$WLAN_ROAM3
driver=nl80211

hw_mode=g
channel=$CHANNEL_ROAM3
ssid=$ESSID_ROAM

wpa=2
# WPA-PSK keeps the classic client-less PMKID; FT-PSK makes this a real
# 802.11r roaming domain (fast transition between the three BSSIDs).
wpa_key_mgmt=WPA-PSK FT-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
wpa_passphrase=$PASS_ROAM_CLEAR

# 802.11r Fast Transition — one mobility domain shared by all three campus APs.
# PMK-R0/R1 are derived locally from the PSK (ft_psk_generate_local) because the
# APs live on isolated /24s and cannot push/pull PMK-R1 over the DS.
mobility_domain=ca11
nas_identifier=campus-ap3
ft_psk_generate_local=1
ft_over_ds=0

ctrl_interface=/run/hostapd-$WLAN_ROAM3
ctrl_interface_group=0
