# --- Probe-request fingerprint persona: legacy device (minimal probe, no Passpoint) ---
# Intentionally adds no extra probe-request IEs; keeps the bare kernel IE set as this
# device's fingerprint, distinguishing it from the Passpoint-capable clients.


  
network={
    ssid="$ESSID_MGT_MSCHAP_EXTRA"
    psk="$PASS_MGT_MSCHAP_EXTRA_CLEAR"
    scan_ssid=1
    key_mgmt=WPA-PSK
    proto=WPA2
}

network={
    ssid="$ESSID_MGT"
    scan_ssid=1
    key_mgmt=WPA-EAP
    eap=PEAP
    identity="$IDENTITY_MGT_MSCHAP"
    password="$PASS_MGT_MSCHAP_CLEAR"
    phase1="peapver=1"
    phase2="auth=MSCHAPV2"
}
