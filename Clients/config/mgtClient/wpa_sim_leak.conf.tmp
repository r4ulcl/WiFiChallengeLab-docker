# --- Probe-request fingerprint persona: modern smartphone (Passpoint / Hotspot 2.0) ---
# wpa_supplicant appends these to probe requests (wpa_supplicant_extra_ies):
#   interworking=1 -> Interworking element (IE 107)
#   hs20=1         -> Hotspot 2.0 Indication (vendor IE 221, WFA OUI)
# This shifts the IE tag-number list that wifi_db hashes, giving this device a
# distinct fingerprint. Probe-only: auto_interworking stays off and there are no
# cred{} blocks, so association to the lab's non-Passpoint APs is unaffected.
# (Note: disable_ht/vht/he would NOT help here - those only affect the assoc
# request, not the probe request the fingerprint is built from.)
interworking=1
hs20=1
access_network_type=2

# Leaking EAP-AKA' client - IMSI 214 07 0936554128.
# INSECURE counterpart of wpa_sim.conf:
#   * eap=AKA' with a PERMANENT identity ("6"<IMSI>@realm), sent in the CLEAR in
#     EAP-Response/Identity - any passive sniffer harvests the IMSI (the classic
#     Wi-Fi "IMSI catcher" exposure).
#   * fast_reauth=0 forces a FULL authentication every time, so the IMSI is re-sent
#     on every reconnect instead of using a pseudonym.
# Software (U)SIM, no PC/SC: password = Ki:OPc:SQN, matched in the AP milenage_db.

ap_scan=1
fast_reauth=0

network={
	ssid="$ESSID_MGT_SIM"
	scan_ssid=1
	key_mgmt=WPA-EAP
	proto=RSN
	pairwise=CCMP
	eap=AKA'
	identity="$IDENTITY_MGT_SIM_LEAK"
	password="$SIM_MGT_LEAK_KI:$SIM_MGT_LEAK_OPC:$SIM_MGT_SQN"
}
