# --- Probe-request fingerprint persona: legacy device (minimal probe, no Passpoint) ---
# Intentionally adds no extra probe-request IEs; keeps the bare kernel IE set as this
# device's fingerprint, distinguishing it from the Passpoint-capable clients.

network={
    ssid="$ESSID_WEP"
    key_mgmt=NONE
    wep_tx_keyidx=0
    wep_key0=$PASS_WEP_CLEAR
}